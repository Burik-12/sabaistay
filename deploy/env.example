# SabaiStay — секреты VPS. Скопируй в /home/rw/sabaistay-secrets/.env (chmod 600).
# НЕ коммитить: реальный .env лежит вне репозитория.

# Telegram API — https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=abcdef1234567890abcdef1234567890

# Телефон аккаунта-сборщика (желательно отдельная SIM, не личный аккаунт RW)
TG_PHONE=+66xxxxxxxxx

# Имя файла Telethon-сессии (абсолютный путь без расширения .session)
TG_SESSION=/home/rw/sabaistay-secrets/sabaistay

# Куда коллектор пишет dumps и откуда пайплайн читает (совпадает с Environment= в юнитах)
SABAI_DATA_DIR=/home/rw/sabaistay/data

# Фаза 5 (бот подписки) — пока не нужно:
# SABAISTAY_BOT_TOKEN=
# SABAISTAY_ADMIN_IDS=
