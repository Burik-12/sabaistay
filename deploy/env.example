# SabaiStay — секреты VPS. Скопируй в /home/rw/sabaistay-secrets/.env (chmod 600).
# НЕ коммитить: реальный .env лежит вне репозитория.

# Telegram API — https://my.telegram.org → API development tools
TG_API_ID=1234567
TG_API_HASH=abcdef1234567890abcdef1234567890

# Телефон аккаунта-сборщика (желательно отдельная SIM, не личный аккаунт RW)
TG_PHONE=+66xxxxxxxxx

# Имя файла Telethon-сессии (абсолютный путь без расширения .session)
TG_SESSION=/home/rw/sabaistay-secrets/sabaistay

# Куда коллектор пишет dumps и откуда пайплайн читает (совпадает с Environment= в юнитах)
SABAI_DATA_DIR=/home/rw/sabaistay/data


# Бот SabaiStay (подписки + приём объявлений через /add) — токен у @BotFather
SABAISTAY_BOT_TOKEN=
# Кому бот шлёт уведомления о новых объявлениях (свой Telegram user id, можно несколько)
SABAISTAY_ADMIN_IDS=
# Имя бота БЕЗ @ — от него зависит кнопка «следить за поиском» на витрине.
# Пока пусто, кнопка не рисуется вовсе (мёртвая ссылка хуже её отсутствия).
SABAI_BOT_USERNAME=

# Адрес сайта — абсолютные ссылки в OG-мете, canonical и sitemap.
# Без него подставляется адрес на Vercel.
SABAI_SITE_URL=
# Контакт на витрине и на странице приватности (куда писать про удаление объявления)
SABAI_CONTACT_TG=
SABAI_CONTACT_EMAIL=

# Facebook-сбор через Apify (docs/facebook-ingest-plan.md)
APIFY_TOKEN=
# Куда слать алерт, если сбор из FB встал (можно тот же бот и тот же чат)
SABAI_ALERT_BOT_TOKEN=
SABAI_ALERT_CHAT_ID=
