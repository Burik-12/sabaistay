# секреты и ключи — НИКОГДА в репозиторий
.env
.env.*
# Telethon-сессии
*.session
*.session-journal
secrets/
# cookie-сессии FB-аккаунтов
cookies/
*credentials*.json

# данные/выгрузки
# ВАЖНО: комментарий пишем ТОЛЬКО на отдельной строке. Приписка в конце строки
# становится частью шаблона, и правило молча перестаёт работать — так сюда
# однажды и попали файлы, которые считались игнорируемыми.

# сырой скрейп (промежуточный), не коммитим
data/raw_*.json
data/dumps/
# подписки пользователей бота (tg_user_id — не коммитим)
data/subscriptions.ndjson
# data/sample_listings.json — НЕ в ignore: GitHub Actions его коммитит при обновлении
# резервная копия перед reparse.py — локальная страховка
*.json.bak
*.sqlite
*.db

# зависимости / сборка
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.next/
dist/
build/

# система
.DS_Store
*.log

# скриншоты-превью
web/_preview.png
.vercel
